{
  "appId": "net.lbry.community.desktop",
  "productName": "LBRY Desktop NG",
  "allowMissingDependencies": false,
  "detectUpdateChannel": false,
  "electronUpdaterCompatibility": ">=4.6.5",
  "directories": {
    "output": "dist/ng"
  },
  "files": [
    {
      "from": "dist/electron/webpack",
      "to": "./"
    },
    {
      "from": "dist/electron/static",
      "to": "./"
    },
    "package.json",
    "node_modules/**/*",
    "!node_modules/electron{,/**/*}"
  ],
  "extraResources": [
    {
      "from": "./static/daemon/",
      "to": "static/daemon/",
      "filter": [
        "lbrynet.exe"
      ]
    },
    {
      "from": "./static/img",
      "to": "static/img",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "./static/font",
      "to": "static/font",
      "filter": [
        "**/*"
      ]
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "kodxana",
      "repo": "lbry-desktop-ng"
    }
  ],
  "protocols": [],
  "nsis": {
    "include": "build/installer.nsh",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "differentialPackage": true,
    "deleteAppDataOnUninstall": false
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "artifactName": "LBRY-Desktop-NG-${version}-windows-${arch}.${ext}",
  "afterSign": null,
  "extraMetadata": {
    "main": "main.js"
  },
  "npmRebuild": false,
  "extraFiles": [
    {
      "from": "build/sdk-candidate.json",
      "to": "SDK-CANDIDATE.json"
    }
  ],
  "copyright": "Copyright \u00a9 LBRY Inc. and LBRY Desktop NG contributors"
}
