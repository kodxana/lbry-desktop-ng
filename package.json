{
  "name": "lbry-desktop-ng",
  "version": "0.54.0-rc.3",
  "description": "Community-maintained restoration of the original LBRY Desktop with LBRY SDK NG.",
  "keywords": [
    "lbry"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kodxana/lbry-desktop-ng",
  "bugs": {
    "url": "https://github.com/kodxana/lbry-desktop-ng/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kodxana/lbry-desktop-ng"
  },
  "author": {
    "name": "LBRY Inc."
  },
  "main": "./dist/electron/webpack/main.js",
  "scripts": {
    "test:desktop": "node build/runDesktopTests.js",
    "test:renderer": "node build/testRenderer.js",
    "test:desktop-package": "node build/testDesktopPackage.js",
    "test:packaged-desktop": "node build/testPackagedDesktop.js",
    "test:desktop-setup": "node build/testDesktopSetup.js",
    "test:sdk-isolation": "node build/testSdkIsolation.js",
    "build:sdk-test": "node build/buildSdkTest.js",
    "analyze": "source-map-explorer --only-mapped dist/electron/webpack/ui*.js --html dist/sourceMap.html",
    "compile:electron": "node --max_old_space_size=4096 ./node_modules/webpack/bin/webpack.js --config webpack.electron.config.js",
    "compile": "cross-env NODE_ENV=production yarn compile:electron",
    "dev": "yarn dev:electron",
    "dev:electron": "cross-env NODE_ENV=development node ./electron/devServer.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build": "yarn build:ng",
    "build:dir": "yarn build -- --dir -c.compression=store -c.mac.identity=null",
    "crossenv": "cross-env",
    "flow": "flow",
    "lint": "eslint 'ui/**/*.{js,jsx}' && eslint 'electron/**/*.js' && flow",
    "lint-fix": "eslint --fix --quiet 'ui/**/*.{js,jsx}' && eslint --fix --quiet 'electron/**/*.js'",
    "format": "prettier 'src/**/*.{js,jsx,scss,json}' --write",
    "flow-defs": "flow-typed install",
    "precommit": "lint-staged",
    "postinstall": "electron-builder install-app-deps && node ./build/downloadDaemon.js",
    "postinstall:warning": "echo '\n\nWARNING\n\nNot all node modules were installed because NODE_ENV is set to \"production\".\nThis should only be set after installing dependencies with \"yarn\". The app will not work.\n\n'",
    "build:ng": "node build/buildDesktop.js",
    "test:desktop-updates": "node build/testDesktopUpdates.js"
  },
